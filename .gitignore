# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Datasets, model weights and local experiment artifacts are not versioned.
# (Committed result images under colab_results/ stay tracked via the negation.)
data/
output/
*.png
!colab_results/**/*.png
*.pth
*.pt

# scratch logs from local runs
*.log
